# Connexion PostgreSQL (Docker Compose local : port 5433)
DATABASE_URL=postgres://plein:plein@localhost:5433/plein_malin

# Départements collectés par le worker (codes séparés par des virgules)
COLLECT_DEPARTEMENTS=all

# Intervalle du mode --watch du worker, en minutes
COLLECT_INTERVAL_MINUTES=15

# --- Neon (écrit par `neon deploy`) ---
# DATABASE_URL=postgresql://…-pooler….neon.tech/neondb?sslmode=require      (pooler : app + collecte)
# DATABASE_URL_UNPOOLED=postgresql://….neon.tech/neondb?sslmode=require      (directe : migrations)
# NEON_BRANCH=production
# NEON_AUTH_BASE_URL=…   NEON_AUTH_JWKS_URL=…   (Neon Auth, pas encore utilisé)

# --- Audience (/stats) ---
# Sel secret des empreintes visiteurs (long et aléatoire ; le changer remet les compteurs « uniques » à zéro)
# ANALYTICS_SALT=
# Mot de passe de la page /stats
# STATS_PASSWORD=
